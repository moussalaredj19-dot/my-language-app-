# VITE_GEMINI_API_KEY: Required for client-side Gemini AI calls via @google/genai.
# Note: Client-side keys are embedded in the browser bundle; restrict the key by HTTP referrer/domain in Google Cloud Console.
VITE_GEMINI_API_KEY="MY_VITE_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
